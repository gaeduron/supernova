---
interface Props {
	name: 'instagram' | 'twitter' | 'twitch';
}

const { name } = Astro.props;
---

{
	name === 'instagram' && (
		<svg class="link-pill-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
			<rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="2" />
			<circle cx="12" cy="12" r="4.25" stroke="currentColor" stroke-width="2" />
			<circle cx="17.5" cy="6.5" r="1.25" fill="currentColor" />
		</svg>
	)
}
{
	name === 'twitter' && (
		<svg class="link-pill-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path
				d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
			/>
		</svg>
	)
}
{
	name === 'twitch' && (
		<svg class="link-pill-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path
				d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"
			/>
		</svg>
	)
}
