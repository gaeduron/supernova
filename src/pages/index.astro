---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import Footer from '../components/Footer.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { getGalleryImages } from '../lib/gallery.ts';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const banner = `${base}images/banner`;
const galleryImages = getGalleryImages(base);

// Both plates carry the logo painted in: the desktop one on the left, the tall
// mobile one under the pair.
const DESKTOP_BANNER = '(min-width: 48rem) and (min-aspect-ratio: 5/4)';

const links = [
	{
		label: 'Instagram',
		href: 'https://www.instagram.com/nicolas_jaffre_/',
		icon: 'instagram' as const,
	},
	{
		label: 'Twitter',
		href: 'https://twitter.com/nicolas_jaffre',
		icon: 'twitter' as const,
	},
	{
		label: 'Twitch',
		href: 'https://www.twitch.tv/nicolas_jaffre',
		icon: 'twitch' as const,
	},
];

const title = 'Supernova, le manga de Nicolas Jaffré | Éditions Kana';
const description =
	'Découvrez le tome 1 de Supernova, les actualités de l\'auteur et les coulisses de la série.';

// schema.org data for Google (knowledge panel, rich results).
const siteURL = new URL(base, Astro.site).href;
const abs = (path: string) => new URL(`${base}${path}`, Astro.site).href;
const schema = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': `${siteURL}#website`,
			url: siteURL,
			name: 'Supernova — Nicolas Jaffré',
			description,
			inLanguage: 'fr-FR',
			publisher: { '@id': `${siteURL}#author` },
		},
		{
			'@type': 'Person',
			'@id': `${siteURL}#author`,
			name: 'Nicolas Jaffré',
			url: siteURL,
			image: abs('images/Author_Nicolas_Jaffré.png'),
			jobTitle: 'Auteur de manga',
			sameAs: links.map((l) => l.href),
		},
		{
			'@type': 'Book',
			'@id': `${siteURL}#supernova`,
			name: 'Supernova',
			url: siteURL,
			image: abs('images/supernova_tome_1_couverture.jpg'),
			inLanguage: 'fr',
			genre: 'Manga',
			bookFormat: 'https://schema.org/Paperback',
			author: { '@id': `${siteURL}#author` },
			publisher: { '@type': 'Organization', name: 'Kana', url: 'https://www.kana.fr' },
		},
	],
};
---

<BaseLayout title={title} description={description} schema={schema}>
	<header class="home-banner">
		<picture>
			<source
				media={DESKTOP_BANNER}
				srcset={`${banner}/banner-desktop-1600.webp 1600w, ${banner}/banner-desktop-2400.webp 2400w`}
				sizes="100vw"
			/>
			<img
				src={`${banner}/banner-mobile-900.webp`}
				srcset={`${banner}/banner-mobile-900.webp 900w, ${banner}/banner-mobile-1400.webp 1400w`}
				sizes="67vh"
				alt="Supernova — les deux héros devant le palais de justice"
				class="home-banner-art"
				fetchpriority="high"
				decoding="async"
			/>
		</picture>

		<img
			src={`${base}images/logo_kana.svg`}
			alt="Supernova"
			class="home-banner-logo"
			width="49"
			height="124"
		/>

		<ul class="home-banner-social">
			{
				links.map(({ label, href, icon }) => (
					<li>
						<a
							href={href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={label}
							class="home-social-btn"
						>
							<SocialIcon name={icon} />
						</a>
					</li>
				))
			}
		</ul>
	</header>

	<section class="home-tagline">
		<p><span class="home-tagline-pause">Obéir…</span>ou tracer sa propre voie.</p>
	</section>

	{
		galleryImages.length > 0 && (
			<section class="home-gallery">
				<Gallery images={galleryImages} title="Actualités" />
			</section>
		)
	}
	<!-- <div style="position: relative; padding-top: max(60%,324px); width: 100%; height: 0;"><iframe style="position: absolute; border: none; width: 100%; height: 100%; left: 0; top: 0;" title="Supernova Chapitre 1" src="https://online.fliphtml5.com/EditionsKana/SupernovaChapitre1/" frameborder="0" scrolling="no" seamless="seamless" allowfullscreen="allowfullscreen"></iframe></div> -->

	<Footer />
</BaseLayout>
