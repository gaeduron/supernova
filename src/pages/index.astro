---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialIcon from '../components/SocialIcon.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const avatar = `${base}images/Supernova_profile_picture_60kb.jpg`;

const links = [
	{
		label: 'Instagram',
		href: 'https://www.instagram.com/nicolas_jaffre_/',
		icon: 'instagram' as const,
	},
	{
		label: 'Twitter',
		href: 'https://twitter.com/nicolas_jaffre',
		icon: 'twitter' as const,
	},
	{
		label: 'Twitch',
		href: 'https://www.twitch.tv/nicolas_jaffre',
		icon: 'twitch' as const,
	},
];
---

<BaseLayout>
	<div class="link-page-bg flex min-h-screen flex-col items-center px-5 py-10 sm:py-16">
		<div class="link-card flex w-full max-w-sm flex-col items-center rounded-3xl p-3 sm:p-4">
			<div class="link-avatar-frame">
				<img
					src={avatar}
					alt="Nicolas Jaffré"
					width="1386"
					height="1405"
					class="link-avatar"
					loading="eager"
					decoding="async"
				/>
			</div>

			<p class="link-name mt-6 text-4xl font-bold leading-none tracking-tighter">Nicolas Jaffre</p>
			<p class="link-subtitle mt-0.5">Auteur de Supernova</p>

			<ul class="mt-8 flex w-full flex-col gap-2">
				{
					links.map(({ label, href, icon }) => (
						<li>
							<a
								href={href}
								target="_blank"
								rel="noopener noreferrer"
								class="link-pill bg-white px-6 py-4"
							>
								<SocialIcon name={icon} />
								<span class="link-pill-label">{label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</BaseLayout>
